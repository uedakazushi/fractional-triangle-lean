CanonicalRoots.enumerateTernaryCandidates_iff (a : ℕ) (ha : 1 ≤ a) (e : CanonicalRoots.TernaryCandidate) :
  e ∈ CanonicalRoots.enumerateTernaryCandidates a ↔ CanonicalRoots.ArithmeticTernary a e
CanonicalRoots.enumerateHigherCandidates_iff (n a : ℕ) (ha : 0 < a) (ps : List ℕ) :
  ps ∈ CanonicalRoots.enumerateHigherCandidates n a ↔ CanonicalRoots.ArithmeticHigher n a ps
structure CanonicalRoots.Target (n a : ℕ) : Type
number of parameters: 2
fields:
  CanonicalRoots.Target.dimension_input : 3 ≤ n
  CanonicalRoots.Target.parameter_input : 1 ≤ a
  CanonicalRoots.Target.signature : Fin n → ℕ
  CanonicalRoots.Target.admissible : CanonicalRoots.AdmissibleSignature self.signature
  CanonicalRoots.Target.tau : CanonicalRoots.DegreeGroup self.signature
  CanonicalRoots.Target.root_equation : CanonicalRoots.IsCanonicalRoot self.signature a self.tau
  CanonicalRoots.Target.presentation : CanonicalRoots.RootHypersurfacePresentation self.signature self.tau
constructor:
  CanonicalRoots.Target.mk {n a : ℕ} (dimension_input : 3 ≤ n) (parameter_input : 1 ≤ a) (signature : Fin n → ℕ)
    (admissible : CanonicalRoots.AdmissibleSignature signature) (tau : CanonicalRoots.DegreeGroup signature)
    (root_equation : CanonicalRoots.IsCanonicalRoot signature a tau)
    (presentation : CanonicalRoots.RootHypersurfacePresentation signature tau) : CanonicalRoots.Target n a
structure CanonicalRoots.RootHypersurfacePresentation {n : ℕ} (p : Fin n → ℕ) (τ : CanonicalRoots.DegreeGroup p) : Type
number of parameters: 3
fields:
  CanonicalRoots.RootHypersurfacePresentation.weights : Fin n → ℕ
  CanonicalRoots.RootHypersurfacePresentation.weights_pos : ∀ (i : Fin n), 0 < self.weights i
  CanonicalRoots.RootHypersurfacePresentation.relationDegree : ℕ
  CanonicalRoots.RootHypersurfacePresentation.relationDegree_pos : 0 < self.relationDegree
  CanonicalRoots.RootHypersurfacePresentation.polynomial : MvPolynomial (Fin n) ℂ
  CanonicalRoots.RootHypersurfacePresentation.polynomial_ne_zero : self.polynomial ≠ 0
  CanonicalRoots.RootHypersurfacePresentation.homogeneous : MvPolynomial.IsWeightedHomogeneous self.weights
      self.polynomial self.relationDegree
  CanonicalRoots.RootHypersurfacePresentation.no_constant_or_linear : CanonicalRoots.HasNoConstantOrLinear
      self.polynomial
  CanonicalRoots.RootHypersurfacePresentation.isolated : CanonicalRoots.IsolatedAtOrigin self.polynomial
  CanonicalRoots.RootHypersurfacePresentation.graded_equiv : CanonicalRoots.GradedAlgEquiv
      (CanonicalRoots.presentedPiece self.polynomial self.weights) (CanonicalRoots.rootPiece p τ)
constructor:
  CanonicalRoots.RootHypersurfacePresentation.mk {n : ℕ} {p : Fin n → ℕ} {τ : CanonicalRoots.DegreeGroup p}
    (weights : Fin n → ℕ) (weights_pos : ∀ (i : Fin n), 0 < weights i) (relationDegree : ℕ)
    (relationDegree_pos : 0 < relationDegree) (polynomial : MvPolynomial (Fin n) ℂ)
    (polynomial_ne_zero : polynomial ≠ 0)
    (homogeneous : MvPolynomial.IsWeightedHomogeneous weights polynomial relationDegree)
    (no_constant_or_linear : CanonicalRoots.HasNoConstantOrLinear polynomial)
    (isolated : CanonicalRoots.IsolatedAtOrigin polynomial)
    (graded_equiv :
      CanonicalRoots.GradedAlgEquiv (CanonicalRoots.presentedPiece polynomial weights) (CanonicalRoots.rootPiece p τ)) :
    CanonicalRoots.RootHypersurfacePresentation p τ
def CanonicalRoots.IsCanonicalRoot : {n : ℕ} → (p : Fin n → ℕ) → ℕ → CanonicalRoots.DegreeGroup p → Prop :=
fun {n} p a τ => a • τ = CanonicalRoots.omegaDegree p
@[reducible] def CanonicalRoots.RootRing : {n : ℕ} →
  (p : Fin n → ℕ) → CanonicalRoots.DegreeGroup p → Subalgebra ℂ (CanonicalRoots.AmbientRing p) :=
fun {n} p τ => CanonicalRoots.rootSubalgebra p τ
def CanonicalRoots.rootModule : {n : ℕ} →
  (p : Fin n → ℕ) → CanonicalRoots.DegreeGroup p → Submodule ℂ (CanonicalRoots.AmbientRing p) :=
fun {n} p τ => ⨆ m, CanonicalRoots.ambientPiece p (m • τ)
def CanonicalRoots.IsolatedAtOrigin : {n : ℕ} → MvPolynomial (Fin n) ℂ → Prop :=
fun {n} f => ∀ (z : Fin n → ℂ), (∀ (i : Fin n), (MvPolynomial.eval z) ((MvPolynomial.pderiv i) f) = 0) ↔ z = 0
structure CanonicalRoots.GradedAlgEquiv.{u_1, u_2} {A : Type u_1} {B : Type u_2} [CommRing A] [CommRing B] [Algebra ℂ A]
  [Algebra ℂ B] (s : ℕ → Submodule ℂ A) (t : ℕ → Submodule ℂ B) : Type (max u_1 u_2)
number of parameters: 8
parents:
  CanonicalRoots.GradedAlgEquiv.toAlgEquiv : A ≃ₐ[ℂ] B
fields:
  Equiv.toFun : A → B
  Equiv.invFun : B → A
  Equiv.left_inv : Function.LeftInverse self.invFun self.toFun := by
    intro;
      first
      | rfl
      | ext <;> rfl
  Equiv.right_inv : Function.RightInverse self.invFun self.toFun := by
    intro;
      first
      | rfl
      | ext <;> rfl
  MulHom.map_mul' : ∀ (x y : A), self.toFun (x * y) = self.toFun x * self.toFun y
  AddHom.map_add' : ∀ (x y : A), self.toFun (x + y) = self.toFun x + self.toFun y
  AlgEquiv.commutes' : ∀ (r : ℂ), self.toFun ((algebraMap ℂ A) r) = (algebraMap ℂ B) r
  CanonicalRoots.GradedAlgEquiv.preserves : ∀ (m : ℕ) (x : A), x ∈ s m ↔ self.toAlgEquiv x ∈ t m
constructor:
  CanonicalRoots.GradedAlgEquiv.mk.{u_1, u_2} {A : Type u_1} {B : Type u_2} [CommRing A] [CommRing B] [Algebra ℂ A]
    [Algebra ℂ B] {s : ℕ → Submodule ℂ A} {t : ℕ → Submodule ℂ B} (toAlgEquiv : A ≃ₐ[ℂ] B)
    (preserves : ∀ (m : ℕ) (x : A), x ∈ s m ↔ toAlgEquiv x ∈ t m) : CanonicalRoots.GradedAlgEquiv s t
field notation resolution order:
  CanonicalRoots.GradedAlgEquiv, AlgEquiv, Equiv, MulEquiv, AddEquiv, RingEquiv, MulHom, AddHom
