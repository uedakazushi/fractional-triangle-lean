CanonicalRoots.canonicalRoot_exists_iff {n a : ℕ} (p : Fin n → ℕ) (hp : ∀ (i : Fin n), 0 < p i) :
  (∃ τ, CanonicalRoots.IsCanonicalRoot p a τ) ↔
    ↑a ∣ CanonicalRoots.signatureIndex p ∧ a.Coprime (CanonicalRoots.signatureLcm p)
CanonicalRoots.canonicalRoot_unique {n a : ℕ} (p : Fin n → ℕ) (hp : ∀ (i : Fin n), 0 < p i) (ha : 0 < a)
  (τ σ : CanonicalRoots.DegreeGroup p) (hτ : CanonicalRoots.IsCanonicalRoot p a τ)
  (hσ : CanonicalRoots.IsCanonicalRoot p a σ) : τ = σ
CanonicalRoots.higher_root_realization {n a : ℕ} (hn : 0 < n) (p : Fin n → ℕ) (hp : ∀ (i : Fin n), 2 ≤ p i) (ha : 0 < a)
  (hcop : Pairwise fun i j => (p i).Coprime (p j))
  (hdefect : ↑(∏ j, p j) - ∑ i, ↑(CanonicalRoots.productWeights p i) = ↑a) :
  ∃ τ,
    CanonicalRoots.IsCanonicalRoot p a τ ∧
      CanonicalRoots.AdmissibleSignature p ∧ Nonempty (CanonicalRoots.RootHypersurfacePresentation p τ)
CanonicalRoots.higherRootGradedEquiv {n a : ℕ} (p : Fin n → ℕ) (hp : ∀ (i : Fin n), 2 ≤ p i) (ha : 0 < a)
  (hcop : Pairwise fun i j => (p i).Coprime (p j))
  (hdefect : ↑(∏ j, p j) - ∑ i, ↑(CanonicalRoots.productWeights p i) = ↑a) (τ : CanonicalRoots.DegreeGroup p)
